{
  "name": "localist",
  "private": true,
  "version": "2.0.0-dev",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "node scripts/vitest.mjs run",
    "test:watch": "node scripts/vitest.mjs",
    "icons": "pwa-assets-generator",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run size",
    "test:rules": "firebase emulators:exec --only firestore --project demo-localist \"node scripts/vitest.mjs run --config vitest.rules.config.ts\"",
    "emulators": "firebase emulators:start --project demo-localist",
    "dev:emu": "firebase emulators:exec --only auth,firestore --project demo-localist --ui \"vite --mode emulators\"",
    "preview:emu": "firebase emulators:exec --only auth,firestore --project demo-localist \"vite build --mode emulators && vite preview --port 4173 --strictPort\"",
    "size": "node scripts/check-bundle.mjs"
  },
  "dependencies": {
    "firebase": "13.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@firebase/rules-unit-testing": "6.0.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vite-pwa/assets-generator": "2.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "firebase-tools": "15.34.1",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5",
    "workbox-window": "7.4.1"
  }
}
