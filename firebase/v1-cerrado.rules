rules_version = '2';

// Proyecto ANTIGUO (locallist-18b64): la V1 está retirada desde el 12-nov-2026.
// Nadie puede leer ni escribir desde fuera. Los datos siguen ahí (el
// propietario los ve en la consola) y hay copia en backups/ (no versionada).
// Desplegado con: firebase deploy --only firestore:rules
//   --project locallist-18b64 --config firebase/v1-cerrado.firebase.json

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
