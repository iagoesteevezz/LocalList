      "html": "<ul class=\"ds-rows\"><li class=\"ds-row\"><span class=\"ds-mark\"></span>Atún en lata</li><li class=\"ds-row ds-done\"><span class=\"ds-mark\"><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg></span><span class=\"ds-name\">Plátanos<svg viewBox=\"0 0 100 14\" preserveAspectRatio=\"none\"><path d=\"M1.5 8.6C14 6.4 27 9.8 41 7.6S69 6.1 82 7.9c6.2.8 11.4.5 16.5-.9\"/></svg></span></li></ul>",
      "css": ".ds-rows{list-style:none;margin:0;padding:0;border-radius:14px;background:#fff;overflow:hidden;font:600 1.125rem ui-rounded,system-ui,sans-serif;color:#13201a}.ds-row{display:flex;align-items:center;gap:14px;min-height:3.5rem;padding:0 14px}.ds-row+.ds-row{border-top:1px solid #cad5cc}.ds-mark{display:grid;place-items:center;width:1.75rem;height:1.75rem;border:2.5px solid #1f3a2d;border-radius:50%;color:#fff}.ds-done .ds-mark{background:#56685c;border-color:#56685c}.ds-done{color:#56685c;font-weight:500}.ds-name{position:relative}.ds-name svg{position:absolute;left:-4px;top:50%;width:calc(100% + 8px);height:14px;transform:translateY(-50%);overflow:visible}.ds-name path{fill:none;stroke:#1f3a2d;stroke-width:2.6;stroke-linecap:round}"
